# Monorepo — ignore deps and build artifacts everywhere

node_modules/

# Next.js (build output — root or under frontend/)
.next/
frontend/.next/
frontend/out/
frontend/build/

# Backend (uploads ignored in backend/.gitignore)
backend/node_modules/

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Logs / OS / tools
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.tsbuildinfo

# Vercel
.vercel/
